# Безопасность
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Суперпользователь Django (автоматическое создание)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=AdminPassword123!
DJANGO_SUPERUSER_USERNAME=admin

# ============================================
# БАЗА ДАННЫХ (PostgreSQL)
# ============================================

POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=StrongPassword123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# REDIS И CELERY
# ============================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisPassword123!
REDIS_DB=0

CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_TIMEZONE=Europe/Moscow
CELERY_ENABLE_UTC=True

# ============================================
# EMAIL РАССЫЛКА
# ============================================

# Для разработки - используем MailHog (контейнер mailhog)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lms.local
ADMIN_EMAIL=admin@example.com

# Для продакшена (раскомментировать при необходимости):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# STRIPE ОПЛАТА
# ============================================

# Тестовые ключи Stripe (получить на https://dashboard.stripe.com/test/apikeys)
STRIPE_API_KEY=sk_test_51PABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
STRIPE_PUBLIC_KEY=pk_test_51PABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
STRIPE_WEBHOOK_SECRET=whsec_abcdefghijklmnopqrstuvwxyz012345

# Валюта по умолчанию
DEFAULT_CURRENCY=rub

# ============================================
# ФРОНТЕНД И URLS
# ============================================

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SITE_URL=http://localhost:8000

PAYMENT_SUCCESS_URL=${FRONTEND_URL}/payment/success/?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=${FRONTEND_URL}/payment/cancel/

# ============================================
# МОНИТОРИНГ И АДМИНИСТРИРОВАНИЕ
# ============================================

# Flower (Celery мониторинг)
FLOWER_USER=admin
FLOWER_PASSWORD=FlowerPassword123!

# pgAdmin (администрирование БД)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=PgAdminPassword123!

# Redis Commander
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=RedisCommander123!

# ============================================
# ФАЙЛЫ И МЕДИА
# ============================================

MEDIA_URL=/media/
MEDIA_ROOT=/app/media/
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles/

# ============================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ============================================

# Время жизни JWT токенов (в минутах)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Пагинация
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Логирование
LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# Тестовые данные (при необходимости)
CREATE_TEST_DATA=True
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=UserPassword123!
TEST_MODERATOR_EMAIL=moderator@example.com
TEST_MODERATOR_PASSWORD=Moderator123!